+    def _dex1_log(self, gripper_cmd):
+        """2026-11-22f: Dex1 command path log at 10 Hz -> ~/VLA/teleop_web/logs/sim_dex1_<date_time>.log (G1_DEX1_LOG=0: off).
+        Per side: received command (DDS q units, 0 closed .. 5.6 open), applied target and measured finger joints (same units),
+        plus how many steps since the last line had no complete command (shared memory read empty / one side missing)."""
+        import os, time
+        if os.environ.get("G1_DEX1_LOG", "1") == "0":
+            return
+        try:
+            ok = bool(gripper_cmd) and len(gripper_cmd.get("left_gripper_cmd", {}).get("positions", [])) >= 1 \
+                and len(gripper_cmd.get("right_gripper_cmd", {}).get("positions", [])) >= 1
+            self._dex1_miss = getattr(self, "_dex1_miss", 0) + (0 if ok else 1)
+            self._dex1_steps = getattr(self, "_dex1_steps", 0) + 1
+            now = time.time()
+            if now - getattr(self, "_dex1_t", 0.0) < 0.1:
+                return
+            self._dex1_t = now
+            if not hasattr(self, "_dex1_f"):
+                d = os.path.expanduser("~/VLA/teleop_web/logs")
+                os.makedirs(d, exist_ok=True)
+                self._dex1_f = open(os.path.join(d, time.strftime("sim_dex1_%Y%m%d_%H%M%S.log")), "a", buffering=1)
+                self._dex1_f.write("# time | per side: cmd (received) tgt (applied) q1 q2 (finger joints), units 0 closed .. 5.6 open | "
+                                   "miss = steps without a complete command / steps since last line\n")
+            u = lambda m: (0.03 - float(m)) / 0.05 * 5.6          # joint metres -> DDS units (inverse of _convert_to_joint_range)
+            # finger joints in gripper_joint_mapping order: left J1, left J2, right J1, right J2
+            jp = self.env.scene["robot"].data.joint_pos[0, self._gripper_target_idx_t].tolist()
+            tgt = self._gripper_buf.tolist() if getattr(self, "_gripper_have", False) else [float("nan")] * 2   # [right, left]
+            rc = (gripper_cmd or {}).get("right_gripper_cmd", {}).get("positions", [None])
+            lc = (gripper_cmd or {}).get("left_gripper_cmd", {}).get("positions", [None])
+            f = lambda v: "  -  " if v is None else f"{u(v):5.2f}"
+            self._dex1_f.write(f"{time.strftime('%H:%M:%S')}.{int(now * 10) % 10} | L cmd {f(lc[0] if lc else None)} tgt {u(tgt[1]):5.2f}"
+                               f" q {u(jp[0]):5.2f} {u(jp[1]):5.2f} | R cmd {f(rc[0] if rc else None)} tgt {u(tgt[0]):5.2f}"
+                               f" q {u(jp[2]):5.2f} {u(jp[3]):5.2f} | miss {self._dex1_miss}/{self._dex1_steps}\n")
+            self._dex1_miss = self._dex1_steps = 0
+        except Exception as e:                                   # logging must never stop the sim
+            if not getattr(self, "_dex1_err", False):
+                print(f"[{self.name}] dex1 log disabled: {e}")
+                self._dex1_err = True
+            os.environ["G1_DEX1_LOG"] = "0"
+
